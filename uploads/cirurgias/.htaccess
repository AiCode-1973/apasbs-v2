# Impede execução de scripts e listagem de diretório
Options -Indexes -ExecCGI

<FilesMatch "\.(php|php3|php4|php5|php7|php8|phtml|phar|pl|py|sh|cgi|htaccess)$">
    Require all denied
</FilesMatch>

# Desliga qualquer handler de script que o servidor possa ter herdado
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
RemoveType    .php .phtml .php3 .php4 .php5 .php7 .php8 .phar

<IfModule mod_php.c>
    php_flag engine off
</IfModule>

# Os arquivos só devem ser servidos pelo controller (action=download)
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Content-Disposition "attachment"
</IfModule>
